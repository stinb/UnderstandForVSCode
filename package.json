		"configuration": [
			{
				"title": "%config.Understand.title%",
				"properties": {
					"understand.ai.chatSize": {
						"type": "string",
						"default": "Half",
						"enum": [
							"Full",
							"Half"
						],
						"description": "%config.understand.ai.chatSize.description%"
					},
					"understand.aiView.enabled": {
						"type": "boolean",
						"default": true,
						"description": "%config.understand.aiView.enabled.description%"
					},
					"understand.aiView.automaticallyGenerate": {
						"type": "boolean",
						"default": false,
						"description": "%config.understand.aiView.automaticallyGenerate.description%"
					},
					"understand.analysis.automaticallyAnalyze": {
						"type": "boolean",
						"default": true,
						"description": "%config.understand.analysis.automaticallyAnalyze.description%"
					},
					"understand.hover": {
						"type": "object",
						"default": {},
						"additionalProperties": {
							"type": "string"
						},
						"markdownDescription": "%config.understand.hover.markdownDescription%",
						"scope": "window"
					},
					"understand.annotations.enabled": {
						"type": "boolean",
						"default": true,
						"description": "%config.understand.annotations.enabled.description%"
					},
					"understand.annotations.gutterIcons": {
						"type": "boolean",
						"default": true,
						"description": "%config.understand.annotations.gutterIcons.description%"
					},
					"understand.annotationBrowser.enabled": {
						"type": "boolean",
						"default": true,
						"description": "%config.understand.annotationBrowser.enabled.description%"
					},
					"understand.fileDecorations.enabled": {
						"type": "boolean",
						"default": true,
						"description": "%config.understand.fileDecorations.enabled.description%"
					},
					"understand.violationsView.enabled": {
