					"when": "config.understand.annotations.enabled && config.understand.annotationBrowser.enabled"
				},
				{
					"icon": "$(type-hierarchy)",
					"id": "understandGraphs",
					"name": "%view.understandGraphs.name%",
					"type": "tree"
				},
				{
					"icon": "$(info)",
					"id": "understandInfo",
					"name": "%view.understandInfo.name%",
					"type": "tree",
					"visibility": "collapsed",
					"when": "config.understand.infoView.enabled && understandApiLicensed"
				},
				{
					"icon": "$(pulse)",
					"id": "understandMetrics",
					"name": "%view.understandMetrics.name%",
					"type": "tree",
					"when": "understandExportLicensed"
				},
				{
					"icon": "$(symbol-reference)",
					"id": "understandReferences",
					"name": "%view.understandReferences.name%",
					"type": "tree"
				},
				{
					"icon": "$(warning)",
					"id": "understandViolationsList",
					"name": "%view.understandViolationsList.name%",
					"type": "tree",
					"visibility": "collapsed",
					"when": "config.understand.violationsView.enabled"
				}
			]
		}
	},
	"dependencies": {
		"vscode-languageclient": "9.0.1"
	},
	"overrides": {
		"tmp": "^0.2.7",
		"qs": "^6.15.2",
		"uuid": "^11.1.1",
		"brace-expansion": "^5.0.12",
		"markdown-it": "^14.3.3",
		"form-data": "^4.0.6",
		"js-yaml": "^4.3.2",
		"fast-uri": "^3.1.5"
	},
	"devDependencies": {
		"@types/markdown-it": "14.1.2",
		"@types/node": "20.11.10",
		"@types/vscode": "1.85.0",
		"@vscode/test-electron": "3.1.0",
		"@vscode/vsce": "3.7.1",
		"esbuild": "0.28.1",
		"typescript": "5.3.3"
	},
	"scripts": {
		"build": "npm install --ignore-scripts && node node_modules/typescript/bin/tsc && esbuild ./src/other/templateRules.ts --bundle --outfile=res/views/templateRules.js --format=iife --global-name=understandTemplateRules --minify && esbuild ./src/graphView/main.js --bundle --outfile=res/views/graph.js --format=iife --minify && esbuild ./src/main.ts --bundle --outfile=extension.js --external:vscode --format=cjs --platform=node --minify && node node_modules/@vscode/vsce/vsce package -o understand.vsix",
		"clean": "git clean -dfX",
		"install": "npm run build && code --install-extension understand.vsix",
		"watch": "npm install --ignore-scripts && esbuild ./src/other/templateRules.ts --bundle --outfile=res/views/templateRules.js --format=iife --global-name=understandTemplateRules --minify && esbuild ./src/graphView/main.js --bundle --outfile=res/views/graph.js --format=iife --minify && esbuild ./src/main.ts --bundle --outfile=extension.js --external:vscode --format=cjs --platform=node --minify --watch"
	}
}
