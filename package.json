{
	"name": "understand",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"version": "1.3.0",
	"publisher": "scitools",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/stinb/UnderstandForVSCode.git"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Data Science",
		"Visualization"
	],
	"keywords": [
		"Understand",
		"Reference",
		"Definition",
		"Problems",
		"Analysis"
	],
	"icon": "res/logoColor.png",
	"main": "extension.js",
	"l10n": "./l10n",
	"activationEvents": [
		"workspaceContains:**/*.und/id.txt",
		"onStartupFinished",
		"onWebviewPanel:understandGraph"
	],
	"contributes": {
		"icons": {
			"understand-annotation": {
				"description": "%icon.understand-annotation.description%",
				"default": {
					"fontPath": "./res/understand-icons.ttf",
					"fontCharacter": "\\E001"
				}
			}
		},
		"colors": [
			{
				"id": "understand.annotationRuler",
				"description": "%color.understand.annotationRuler.description%",
				"defaults": {
					"dark": "#3794ff",
					"light": "#3794ff",
					"highContrast": "#3794ff",
					"highContrastLight": "#3794ff"
				}
			},
			{
				"id": "understand.annotationRulerIgnore",
				"description": "%color.understand.annotationRulerIgnore.description%",
				"defaults": {
					"dark": "editorWarning.foreground",
					"light": "editorWarning.foreground",
					"highContrast": "editorWarning.foreground",
					"highContrastLight": "editorWarning.foreground"
				}
			},
			{
				"id": "understand.annotationRulerIncomplete",
				"description": "%color.understand.annotationRulerIncomplete.description%",
				"defaults": {
					"dark": "editorError.foreground",
					"light": "editorError.foreground",
					"highContrast": "editorError.foreground",
					"highContrastLight": "editorError.foreground"
				}
			}
		],
		"viewsWelcome": [
			{
				"view": "understandInfo",
				"contents": "%welcome.understandInfo.1%"
			},
			{
				"view": "understandAnnotationBrowser",
				"contents": "%welcome.understandAnnotationBrowser.1%"
			},
			{
				"view": "understandViolationsList",
				"contents": "%welcome.understandViolationsList.1%",
				"when": "!understand.violationsListed"
			},
			{
				"view": "understandViolationsList",
				"contents": "%welcome.understandViolationsList.2%",
				"when": "understand.violationsListed && understand.violationsListScope != file && !understandCodeCheckLicensed"
			},
			{
				"view": "understandViolationsList",
				"contents": "%welcome.understandViolationsList.3%",
				"when": "understand.violationsListed && understand.violationsListScope != file && understandCodeCheckLicensed"
			},
			{
				"view": "understandViolationsList",
				"contents": "%welcome.understandViolationsList.4%",
				"when": "understand.violationsListed && understand.violationsListScope == file"
			}
		],
		"jsonValidation": [
			{
				"fileMatch": "**/codecheck/configs/*.json",
				"url": "./res/codecheckConfigSchema.json"
			}
		],
		"commands": [
